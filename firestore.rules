rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == 'filipmachala88@gmail.com') ||
        (isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validations ---

    function isValidMusicProgram(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() <= 200 &&
             (!('tag' in data) || (data.tag is string && data.tag.size() <= 100)) &&
             (!('order' in data) || data.order is number);
    }

    function isValidTalkshow(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() <= 300 &&
             (!('order' in data) || data.order is number);
    }

    function isValidFamilyProgram(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() <= 300 &&
             (!('order' in data) || data.order is number);
    }

    function isValidCommunitySection(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() <= 300 &&
             (!('order' in data) || data.order is number);
    }

    function isValidIntroSection(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() <= 500 &&
             (!('order' in data) || data.order is number);
    }

    function isValidIntroInfoItem(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() <= 500 &&
             (!('order' in data) || data.order is number);
    }

    function isValidPracticalInfo(data) {
      return data.keys().hasAll(['label', 'text']) &&
             data.label is string && data.label.size() <= 200 &&
             (!('order' in data) || data.order is number);
    }

    function isValidAboutSection(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() <= 500 &&
             (!('order' in data) || data.order is number);
    }

    function isValidContactSubmission(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.message is string && data.message.size() <= 5000;
    }

    // --- Match Rules ---

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /musicProgram/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /talkshows/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /familyProgram/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /communitySections/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /introSections/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /introInfoItems/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /practicalInfo/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /aboutSections/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /organizations/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /festivalLists/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contactSubmissions/{id} {
      allow read: if isAdmin();
      allow create: if isValidContactSubmission(incoming());
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
